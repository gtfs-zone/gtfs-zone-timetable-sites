{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "gtfs-zone-web-common/*": ["./node_modules/gtfs-zone-web-common/src/*"]
    }
  },
  "include": ["src/js"]
}
